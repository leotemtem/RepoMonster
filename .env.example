POSTGRES_DB=repomonster
POSTGRES_USER=repomonster
POSTGRES_PASSWORD=replace-with-a-random-password
REPOMONSTER_PORT=8000
# Separate credential for callers of POST /review. Leave empty to disable that route.
REPOMONSTER_API_KEY=
# Optional company-policy retrieval namespace. No public company ingestion workflow exists yet.
TENANT_KEY=
LOG_LEVEL=INFO

# Embeddings are used for both bundled packs and repository-owned knowledge.
EMBEDDING_BASE_URL=https://your-endpoint.example/v1
EMBEDDING_MODEL=your-embedding-model
EMBEDDING_DIMENSIONS=1536
EMBEDDING_API_KEY=

# Optional. Select anthropic explicitly to use Claude; otherwise a base URL enables
# the OpenAI-compatible provider. Empty settings leave deterministic checks only.
INSIGHT_PROVIDER=
INSIGHT_BASE_URL=
INSIGHT_MODEL=
INSIGHT_API_KEY=
INSIGHT_EFFORT=
INSIGHT_TIMEOUT_SECONDS=
INSIGHT_MAX_TOKENS=
ANTHROPIC_API_KEY=
ANTHROPIC_AUTH_TOKEN=
ANTHROPIC_BASE_URL=

# GitHub App provider. The private-key path is inside the worker container.
GITHUB_APP_ID=
GITHUB_PRIVATE_KEY_PATH=/run/secrets/github_app_key
GITHUB_WEBHOOK_SECRET=
GITHUB_API_URL=https://api.github.com
GITHUB_API_VERSION=2026-03-10
GITHUB_TIMEOUT_SECONDS=30
GITHUB_MAX_CHANGED_FILES=1000
GITHUB_MAX_KNOWLEDGE_FILES=100
GITHUB_MAX_KNOWLEDGE_FILE_BYTES=500000
MAX_WEBHOOK_BYTES=2000000
WEBHOOK_MAX_ATTEMPTS=5
WEBHOOK_LOCK_TIMEOUT_SECONDS=900
WORKER_POLL_SECONDS=2
